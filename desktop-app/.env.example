VITE_LICENSE_SERVER_URL="http://localhost:4000"
LICENSE_CACHE_SECRET="dev-license-cache-secret"

# Optional: port for the browser-mode local worker (default: 5174)
VIDEO_REPOSTER_BROWSER_PORT=5174

