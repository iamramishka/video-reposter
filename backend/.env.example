DATABASE_URL="postgresql://videoreposter:videoreposter@localhost:5432/video_reposter?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
PRODUCTION_BASE_URL="https://your-production-domain.example.com"
ADMIN_EMAIL="admin@videoreposter.local"
ADMIN_PASSWORD="admin12345"

# Optional: admin session timeout in minutes (default: 480 = 8 hours)
ADMIN_SESSION_TIMEOUT_MINUTES=480

# Optional: set to "false" to disable HTTPS redirect enforcement in production
ENFORCE_HTTPS=

# Stripe payments (optional — omit STRIPE_SECRET_KEY to disable payment features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Email notifications (optional — omit SMTP_HOST to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Video Reposter <noreply@videoreposter.app>"
