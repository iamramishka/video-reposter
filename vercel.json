{
  "buildCommand": "npm run db:generate -w backend && npm run build -w admin-dashboard",
  "outputDirectory": "admin-dashboard/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
