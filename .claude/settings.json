{
  "model": "sonnet",
  "env": {
    "VIDEO_REPOSTER_PROJECT": "Video Reposter",
    "VIDEO_REPOSTER_DEFAULT_GATE": "npm run ship"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(npm test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run build)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run ship)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run ship)"
    ],
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git worktree *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git worktree *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Agent(model:opus)",
      "Agent(isolation:worktree)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(rm * -r *)",
      "PowerShell(rm * -rf *)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/pre-commit-guard.ps1 -Mode TouchedWorkspace"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/pre-commit-guard.ps1 -Mode CommitCommand"
          }
        ]
      }
    ]
  }
}
