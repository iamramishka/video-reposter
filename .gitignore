# Ignore compiled output and node modules
node_modules/
dist/
build/
out/
.next/
.turbo/

# Desktop app build artifacts
desktop-app/dist/
desktop-app/dist-electron/
desktop-app/dist-renderer/
desktop-app/build/
desktop-app/.webpack/
desktop-app/release/
*.exe
*.dmg
*.AppImage
*.deb

# Environment files — NEVER commit these
.env
.env.local
.env.development
.env.production
.env.*.local
backend/.env
admin-dashboard/.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite databases (local dev only)
*.db
*.sqlite
*.sqlite3

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp and cache
.cache/
tmp/
temp/
Temp/
*.tmp

# Video output files (local processing output — do not commit)
desktop-app/Output/
desktop-app/Temp/
Output/

# License cache (encrypted, but still don't commit)
*.enc
license.cache

# Test coverage
coverage/
.nyc_output/

# Package lock files (keep one, gitignore others)
# Uncomment the one you do NOT use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Reports (generated, not source)
Reports/*.pdf
Reports/*.csv

# Electron specific
desktop-app/.electron-builder-effective-config.yaml

.vercel

# Claude Code local overrides
.claude/settings.local.json

# Husky generated install shims
.husky/_/
