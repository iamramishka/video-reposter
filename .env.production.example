# Copy this file to `.env.production` for local readiness checks.
# Do not commit the real `.env.production` file.

DATABASE_URL="postgresql://user:password@host:5432/video_reposter?schema=public"
JWT_SECRET="replace-with-64-plus-random-characters-from-openssl-rand-hex-32"
CORS_ORIGIN="https://admin.videoreposter.example.com"
VITE_API_URL="https://api.videoreposter.example.com"
PRODUCTION_BASE_URL="https://api.videoreposter.example.com"
ADMIN_EMAIL="admin@videoreposter.example.com"
ADMIN_PASSWORD="replace-with-a-strong-production-admin-password"

# Optional: Supabase REST repositories instead of direct Prisma/PostgreSQL.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Stripe payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# Optional: SMTP email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Video Reposter <noreply@videoreposter.app>"

# Optional: desktop update manifest.
VIDEO_REPOSTER_UPDATE_URL="https://updates.videoreposter.com/api/updates/latest"
